{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:recommended',
        ':semanticCommitsDisabled',
    ],
    packageRules: [
        {
            matchPackageNames: [
                'AspNet.Security.OAuth.GitHub',
            ],
            allowedVersions: '<9.0.0',
            matchCurrentVersion: '/^8\\./',
        },
    ],
    prHourlyLimit: 0,
}
